generator client {
  provider  = "prisma-client-py"
  interface = "asyncio"
}

datasource db {
  provider = "mongodb"
  url      = "mongodb+srv://mantissa6789:Mantis%402510@cluster0.9ramotn.mongodb.net/dbName=iss"
}

type LogDetails {
  fromContainer String
  reason        String
  /// Could not determine type: the field only had null or empty values in the sample set.
  toContainer   Json?
}

type PlacementEndPos {
  x Int
  y Int
  z Int
}

type PlacementStartPos {
  x Int
  y Int
  z Int
}

model Container {
  id          String @id @map("_id")
  containerId String @unique
  depth       BigInt
  height      BigInt
  width       BigInt
  zone        String
}

model Item {
  id            String   @id @map("_id")
  createdAt     DateTime @db.Date
  depth         BigInt
  expiryDate    String
  height        BigInt
  itemId        String   @unique
  mass          BigInt
  name          String
  preferredZone String
  priority      BigInt
  updatedAt     DateTime @db.Date
  usageLimit    BigInt
  width         BigInt
}

model Log {
  id         String     @id @map("_id")
  actionType String
  details    LogDetails
  itemId     String
  timestamp  DateTime   @db.Date
  userId     String
}

model Placement {
  id          String            @id @map("_id")
  containerId String
  createdAt   DateTime          @db.Date
  endPos      PlacementEndPos
  itemId      String
  startPos    PlacementStartPos
  updatedAt   DateTime          @db.Date
}

model Zone {
  id            String   @id @map("_id")
  containersIds String[]
  name          String
}
